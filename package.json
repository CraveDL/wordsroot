    "build-all": "node tools/build-db.js && npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.2.8",
    "@gsap/react": "2.1.2",
    "@vitejs/plugin-react": "5.0.4",
    "gsap": "3.13.0",
    "lenis": "1.3.11",
    "motion": "12.23.22",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "7.1.9",
    "xlsx": "0.18.5"
  }
}
