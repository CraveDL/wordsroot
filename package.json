{
  "name": "rootquest",
  "version": "3.0.0",
  "description": "词根驿站：按前缀、后缀、词根闯关学英语单词",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "build-db": "node tools/build-db.js",
